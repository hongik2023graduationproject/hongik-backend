# hongik-backend 환경 변수 예시
# 실제 운영 값은 별도 .env 파일이나 시크릿 매니저로 관리한다 (이 파일은 커밋됨).
#
# 백엔드는 데이터 도메인(스니펫/공유/auth) + 메타 조회만 담당. 사용자 코드 실행은
# WASM-only로 클라이언트로 이전되어 인터프리터 관련 env vars
# (INTERPRETER_PATH / EXECUTE_TIMEOUT / MAX_CONCURRENT_EXEC / MAX_OUTPUT_BYTES /
# CACHE_TTL_EXECUTE)는 더 이상 사용되지 않는다.

# ────────────────────────────────────
# 기본 (Required)
# ────────────────────────────────────

# HTTP 포트
PORT=8080

# 환경 식별 (development | production)
# production일 때 JWT_SECRET 검증, gin release mode 등이 켜진다.
ENV=production

# ────────────────────────────────────
# 인증 (Required in production)
# ────────────────────────────────────

# JWT 서명 키. production에서는:
#   - 기본 placeholder 거부
#   - 빈 값 거부
#   - 32자 미만 거부
# 안전한 값 생성 예시: `openssl rand -base64 48`
JWT_SECRET=

# ────────────────────────────────────
# CORS
# ────────────────────────────────────

# 허용할 frontend origin. 쉼표로 구분, 와일드카드 없음.
CORS_ORIGINS=https://hongik.tolelom.xyz,https://hongik.docs.tolelom.xyz

# ────────────────────────────────────
# 데이터 계층
# ────────────────────────────────────

# PostgreSQL 연결 문자열. 비우면 in-memory 모드로 동작 (개발/시연용; 재시작 시 데이터 손실).
DATABASE_URL=postgres://user:password@postgres:5432/hongik?sslmode=disable

# Redis 연결 문자열. 비우면 캐싱 비활성화 (서비스는 정상 동작, 응답 약간 느려짐).
REDIS_URL=redis://redis:6379/0

# 스니펫/공유 조회 캐시 TTL (초). 0 또는 음수도 동작 가능 (전체 read를 매번 DB로).
CACHE_TTL_DATA=300

# ────────────────────────────────────
# 로깅
# ────────────────────────────────────

# slog 레벨: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ────────────────────────────────────
# 관측 (선택 — 미구현, env var만 예약)
# ────────────────────────────────────

# Sentry 통합은 인프라 결정 후 추가 예정.
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=
